 // untouched so SAI's own mouse painting still works — streaming hover packets
 // for every mouse move told SAI a pen was always present and suppressed mouse
 // paint entirely. A tablet-generated mouse event carries subtype tabletPoint(1).
+func extractPressure(from event: CGEvent) -> Double {
+    var pr = event.getDoubleValueField(.tabletEventPointPressure)
+    if pr == 0, let nsEv = NSEvent(cgEvent: event) {
+        pr = Double(nsEv.pressure)
+    }
+    return pr
+}
+
 func isTabletMouse(_ e: CGEvent) -> Bool {
-    return e.getIntegerValueField(.mouseEventSubtype) == 1   // kCGEventMouseSubtypeTabletPoint
+    let sub = e.getIntegerValueField(.mouseEventSubtype)
+    let nsEv = NSEvent(cgEvent: e)
+    let nsSub = nsEv?.subtype.rawValue ?? -1
+    let press = nsEv?.pressure ?? -1.0
+    
+    if e.type == .leftMouseDown || e.type == .leftMouseDragged {
+        print("[DEBUG] evt=\(e.type.rawValue) cgSub=\(sub) nsSub=\(nsSub) press=\(press) penInRange=\(penInRange)")
+    }
+    
+    if sub == 1 { return true }
+    if nsSub == NSEvent.EventSubtype.tabletPoint.rawValue { return true }
+    return false
 }
 
