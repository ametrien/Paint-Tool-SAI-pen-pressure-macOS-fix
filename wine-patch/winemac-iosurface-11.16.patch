+        DWORD *dst_row = (DWORD *)((BYTE *)shape_mask->data + y * shape_mask->rowBytes);
+
+        for (x = 0; x < width; x++)
+            dst_row[x] = ((src_row[x / 8] >> (7 - x % 8)) & 1) ? 0xffffffff : 0;
+    }
+}
