# macOS
.DS_Store

# build artifacts (rebuilt from source; see README "Build from source").
# The compiled helper is NOT committed — install.sh / make-app.sh build it
# automatically with the stock Xcode command-line tools. wintab32.dll IS
# committed (cross-compiling it needs mingw-w64, too big an ask for users).
wintab-src/wintab32_res.o
wacom-helper/wacom-pressure-helper
make-icon
tools/sai-offset-scan

# NEVER commit proprietary SAI files or licenses
*.exe
*.slc
# ...but OUR OWN Windows build artifact is not one of those. wtprobe.exe is the
# bridge probe, committed for the same reason wintab32.dll is: building it needs
# mingw-w64, which no user of this app has. The blanket *.exe above exists to
# keep SAI's binaries out, not ours.
!wintab-src/wtprobe.exe
PaintToolSAI/
SAI2/

# local/per-machine files generated by install.sh
Start SAI2 (my setup).command
helper.log

dist/
timelapse-encoder/sai-timelapse-encoder
